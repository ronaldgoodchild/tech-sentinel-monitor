{
  "tenant": {
    "name": "Example Home Lab",
    "slug": "regteches"
  },
  "monitors": [
    {
      "name": "DS420J NAS - Ping",
      "monitor_type": "ping",
      "target": "192.168.1.248",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "ds420j-ping"
    },
    {
      "name": "DS420J NAS - Web UI",
      "monitor_type": "http",
      "target": "http://192.168.1.248:5000",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "ds420j-http",
      "config": { "method": "GET", "expected_status": 200 }
    },
    {
      "name": "DS420J NAS - SMB",
      "monitor_type": "tcp",
