      }
    }
  ],
  "status_pages": [
    {
      "name": "REGTeches Network Status",
      "slug": "regteches-status",
      "external_id": "regteches-status-page",
      "monitor_refs": [
        "ds420j-ping", "ds420j-http", "ds420j-smb", "ds420j-https",
        "ds1512-ping", "ds1512-http", "ds1512-smb", "ds1512-ftps",
