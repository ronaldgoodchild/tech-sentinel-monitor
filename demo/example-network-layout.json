{
  "tenant": {
    "name": "Example Home Lab",
    "slug": "example-lab"
  },
  "monitors": [
    {
      "name": "Cloudflare DNS - Ping",
      "monitor_type": "ping",
      "target": "1.1.1.1",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "cloudflare-ping"
    },
    {
      "name": "Cloudflare DNS - HTTPS",
      "monitor_type": "tcp",
      "target": "1.1.1.1:443",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "cloudflare-https"
    },
    {
      "name": "Google DNS - Ping",
      "monitor_type": "ping",
      "target": "8.8.8.8",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "google-dns-ping"
    },
    {
      "name": "Google DNS - HTTPS",
      "monitor_type": "tcp",
      "target": "8.8.8.8:443",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "google-dns-https"
    },
    {
      "name": "Quad9 DNS - Ping",
      "monitor_type": "ping",
      "target": "9.9.9.9",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "quad9-ping"
    },
    {
      "name": "Quad9 DNS - HTTPS",
      "monitor_type": "tcp",
      "target": "9.9.9.9:443",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "quad9-https"
    },
    {
      "name": "GitHub - Website",
      "monitor_type": "http",
      "target": "https://github.com",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "github-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "GitHub - SSH",
      "monitor_type": "tcp",
      "target": "github.com:22",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "github-ssh"
    },
    {
      "name": "Example.com - Website",
      "monitor_type": "http",
      "target": "https://example.com",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "example-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "Wikipedia - Website",
      "monitor_type": "http",
      "target": "https://www.wikipedia.org",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "wikipedia-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "Python.org - Website",
      "monitor_type": "http",
      "target": "https://www.python.org",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "python-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "PyPI - Website",
      "monitor_type": "http",
      "target": "https://pypi.org",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "pypi-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "Debian Mirror - Website",
      "monitor_type": "http",
      "target": "https://deb.debian.org",
      "interval_seconds": 120,
      "timeout_seconds": 10,
      "external_id": "debian-http",
      "config": {
        "method": "GET",
        "expected_status": 200
      }
    },
    {
      "name": "Localhost - Ping",
      "monitor_type": "ping",
      "target": "127.0.0.1",
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "external_id": "localhost-ping"
    }
  ],
  "alert_channels": [
    {
      "name": "REGTeches Webhook",
      "channel_type": "webhook",
      "external_id": "regteches-webhook",
      "config": {
        "url": "{{REGTECHES_WEBHOOK_URL}}"
      }
    }
  ],
  "status_pages": [
    {
      "name": "Example Network Status",
      "slug": "example-status",
      "external_id": "example-status-page",
      "monitor_refs": [
        "cloudflare-ping",
        "cloudflare-https",
        "google-dns-ping",
        "google-dns-https",
        "quad9-ping",
        "quad9-https",
        "github-http",
        "github-ssh",
        "example-http",
        "wikipedia-http",
        "python-http",
        "pypi-http",
        "debian-http",
        "localhost-ping"
      ],
      "theme": {
        "bg_primary": "#0f1117",
        "bg_secondary": "#1a1d27",
        "bg_card": "#222636",
        "text_primary": "#e1e4ed",
        "text_secondary": "#8b8fa3",
        "accent": "#3b82f6"
      }
    }
  ]
}