        "plex-ping", "plex-http", "plex-smb", "plex-rdp",
        "sonarr-http", "radarr-http", "lidarr-http", "sabnzbd-http",
        "dell-proxmox-ping", "hikvision-ping",
        "hp3-proxmox-ping", "hp3-proxmox-web",
