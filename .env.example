# Tech Sentinel Monitor — Environment Configuration
# Copy to .env and fill in your values

# ── Database (TimescaleDB) ──────────────────────
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=techsentinel
POSTGRES_USER=tsadmin
POSTGRES_PASSWORD=****word

# ── Redis ───────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Control Plane API ───────────────────────────
TS_API_HOST=0.0.0.0
TS_API_PORT=8000
TS_API_KEY=changeme_api_key
TS_JWT_SECRET=changeme_jwt_secret
TS_JWT_ALGORITHM=HS256
TS_JWT_EXPIRE_MINUTES=60

# TLS enforcement: reject credential-bearing requests over plaintext HTTP
# Set to 'false' for local development only (NOT recommended for production)
# When enabled, API keys and tokens can only be sent over HTTPS
TS_REQUIRE_TLS=true

# ── Probe Worker ────────────────────────────────
TS_PROBE_CONCURRENCY=10
TS_PROBE_INTERVAL_SECONDS=60
TS_PROBE_TIMEOUT_SECONDS=10

# ── Status Page ─────────────────────────────────
TS_STATUS_HOST=0.0.0.0
TS_STATUS_PORT=8001
TS_CONTROL_PLANE_URL=http://control-plane:8000

# ── Alerting ────────────────────────────────────
TS_ALERT_CONSECUTIVE_FAILURES=3
TS_SLACK_WEBHOOK_URL=
TS_PAGERDUTY_ROUTING_KEY=
TS_AUTOMATION_URL=
TS_AUTOMATION_API_KEY=

# ── Demo (ACME Corp) ───────────────────────────
ACME_WEBHOOK_URL=https://example.com/webhook
ACME_SLACK_WEBHOOK=https://hooks.slack.com/services/CHANGE/ME
ACME_PD_ROUTING_KEY=changeme_pagerduty_key
